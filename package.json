{
  "name": "@virenbar/nuxt-lanyard",
  "version": "1.5.1",
  "description": "A Nuxt module to track your Discord status using Lanyard API",
  "keywords": [
    "nuxt",
    "lanyard"
  ],
  "homepage": "https://github.com/Virenbar/nuxt-lanyard#readme",
  "repository": {
    "type": "github",
    "url": "https://github.com/Virenbar/nuxt-lanyard.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "dev:release": "npm run lint && npm run test && npm run prepack && changelogen --release",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.3" ,
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.2",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13" 
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
